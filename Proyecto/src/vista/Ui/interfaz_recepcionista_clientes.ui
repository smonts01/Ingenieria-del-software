  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#card1, QFrame#card2, QFrame#card3, QFrame#card4, QFrame#cardTabla, QFrame#cardPago, QFrame#cardActividad, QFrame#cardConsejo, QFrame#cardMotivacion, QFrame#cardSigue { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QPushButton#btnInicio { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnEstadisticas, QPushButton#btnCalorias, QPushButton#btnPerfil, QPushButton#btnInformacion { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover, QPushButton#btnCalorias:hover, QPushButton#btnPerfil:hover, QPushButton#btnInformacion:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnVerInscripciones { background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnMini { background-color: transparent; color: #00A896; border: none; font: bold 9pt &quot;Segoe UI&quot;; }
QTableWidget { background-color: white; border: 1px solid #E6E6E6; border-radius: 8px; gridline-color: #E6E6E6; font: 9pt &quot;Segoe UI&quot;; }
QHeaderView::section { background-color: white; color: #1F2937; font: bold 9pt &quot;Segoe UI&quot;; border: none; border-bottom: 1px solid #E6E6E6; padding: 6px; }</string>
  </property>
