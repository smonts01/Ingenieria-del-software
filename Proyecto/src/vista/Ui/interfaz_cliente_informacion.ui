  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardSobre, QFrame#cardHorario, QFrame#cardUbicacion, QFrame#cardServicios, QFrame#cardNormas, QFrame#cardContacto, QFrame#cardSigue { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QPushButton#btnInformacion { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio, QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnEstadisticas, QPushButton#btnCalorias, QPushButton#btnPerfil { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio:hover, QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover, QPushButton#btnCalorias:hover, QPushButton#btnPerfil:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnMapa { background-color: transparent; color: #00A896; border: none; font: bold 9pt &quot;Segoe UI&quot;; }
QLabel#lblCheck1, QLabel#lblCheck2, QLabel#lblCheck3, QLabel#lblCheck4, QLabel#lblCheck5, QLabel#lblCheck6, QLabel#lblCheck7, QLabel#lblNorma1, QLabel#lblNorma2, QLabel#lblNorma3, QLabel#lblNorma4, QLabel#lblNorma5, QLabel#lblNorma6 { color: #18B7A5; font: bold 11pt &quot;Segoe UI&quot;; }</string>
