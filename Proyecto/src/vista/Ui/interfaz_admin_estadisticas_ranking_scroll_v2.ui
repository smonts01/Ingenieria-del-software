QPushButton#btnCerrarSesion, QPushButton#btnActualizar { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 9pt &quot;Segoe UI&quot;; }
QComboBox { background-color: white; border: 1px solid #D9DEE7; border-radius: 8px; padding-left: 10px; font: 9pt &quot;Segoe UI&quot;; color: #6B7280; }
QTableWidget { background-color: white; border: 1px solid #E6E6E6; border-radius: 8px; gridline-color: #E6E6E6; font: 9pt &quot;Segoe UI&quot;; selection-background-color:#E6F7F5; }
QHeaderView::section { background-color: white; color: #1F2937; font: bold 9pt &quot;Segoe UI&quot;; border: none; border-bottom: 1px solid #E6E6E6; padding: 6px; }
QProgressBar { background-color: #EEF2F7; border: none; border-radius: 6px; text-align: center; color: #1F2937; font: bold 8pt &quot;Segoe UI&quot;; }
QProgressBar::chunk { background-color: #18B7A5; border-radius: 6px; }
