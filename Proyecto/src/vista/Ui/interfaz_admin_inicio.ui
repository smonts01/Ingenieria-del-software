  <property name="windowTitle">
   <string>StayFit - Panel Administrador</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardUsuarios, QFrame#cardClases, QFrame#cardInscripciones, QFrame#cardIngresos, QFrame#cardTabla, QFrame#cardGrafico, QFrame#cardAcciones, QFrame#cardPopulares, QFrame#cardActividad, QFrame#cardSistema, QFrame#cardSigue { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QPushButton#btnInicio { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnUsuarios, QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnEstadisticas, QPushButton#btnConfiguracion, QPushButton#btnReportes, QPushButton#btnAyuda { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnUsuarios:hover, QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover, QPushButton#btnConfiguracion:hover, QPushButton#btnReportes:hover, QPushButton#btnAyuda:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnAccionPrincipal { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; text-align: left; padding-left: 14px; font: bold 9pt &quot;Segoe UI&quot;; }
QPushButton#btnAccion { background-color: white; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; text-align: left; padding-left: 14px; font: 9pt &quot;Segoe UI&quot;; }
QPushButton#btnMini { background-color: transparent; color: #00A896; border: none; font: bold 9pt &quot;Segoe UI&quot;; }
QTableWidget { background-color: white; border: 1px solid #E6E6E6; border-radius: 8px; gridline-color: #E6E6E6; font: 8pt &quot;Segoe UI&quot;; }
QHeaderView::section { background-color: white; color: #1F2937; font: bold 8pt &quot;Segoe UI&quot;; border: none; border-bottom: 1px solid #E6E6E6; padding: 5px; }</string>
  </property>
