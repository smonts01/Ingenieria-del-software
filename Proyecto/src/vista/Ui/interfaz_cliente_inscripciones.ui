 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1200</width><height>700</height></rect></property>
  <property name="windowTitle"><string>StayFit - Mis inscripciones</string></property>
  <property name="styleSheet"><string notr="true">
QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: "Segoe UI"; }
QPushButton { font-family: "Segoe UI"; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardFiltros, QFrame#cardResumen, QFrame#cardProxima, QFrame#cardInfo, QFrame#cardSigue,
QFrame#cardClase1, QFrame#cardClase2, QFrame#cardClase3, QFrame#cardClase4, QFrame#cardClase5 {
    background-color: white; border: 1px solid #E6E6E6; border-radius: 12px;
}
QPushButton#btnInscripciones { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt "Segoe UI"; }
QPushButton#btnInicio, QPushButton#btnClases, QPushButton#btnPagos, QPushButton#btnEstadisticas, QPushButton#btnCalorias, QPushButton#btnPerfil, QPushButton#btnInformacion {
    background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt "Segoe UI";
}
QPushButton#btnInicio:hover, QPushButton#btnClases:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover, QPushButton#btnCalorias:hover, QPushButton#btnPerfil:hover, QPushButton#btnInformacion:hover {
    background-color: #E6F7F5; border-radius: 8px;
}
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt "Segoe UI"; }
QPushButton#btnVerDetalles1, QPushButton#btnVerDetalles2, QPushButton#btnVerDetalles3, QPushButton#btnVerDetalles4, QPushButton#btnVerDetalles5, QPushButton#btnAplicarFiltros {
    background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 9pt "Segoe UI";
}
QPushButton#btnTodasClases { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 9pt "Segoe UI"; }
QPushButton#btnTabActivas { background-color: transparent; color: #00A896; border: none; border-bottom: 2px solid #00A896; font: bold 10pt "Segoe UI"; }
QPushButton#btnTabCompletadas, QPushButton#btnTabCanceladas { background-color: transparent; color: #4B5563; border: none; font: 10pt "Segoe UI"; }
QLineEdit, QComboBox { background-color: white; border: 1px solid #DDE3EA; border-radius: 8px; padding-left: 12px; font: 9pt "Segoe UI"; color: #4B5563; }
</string></property>
