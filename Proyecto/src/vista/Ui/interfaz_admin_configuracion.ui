  <property name="windowTitle">
   <string>StayFit - Configuración Administrador</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardPerfil, QFrame#cardSistema, QFrame#cardSeguridad, QFrame#cardNotificaciones, QFrame#cardPreferencias, QFrame#cardBackup, QFrame#cardSigue { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QPushButton#btnConfiguracion { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio, QPushButton#btnUsuarios, QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnEstadisticas { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio:hover, QPushButton#btnUsuarios:hover, QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnGuardar, QPushButton#btnBackup { background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnCancelar, QPushButton#btnRestaurar { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QLineEdit, QComboBox { background-color: white; border: 1px solid #D9DEE7; border-radius: 8px; padding-left: 10px; font: 9pt &quot;Segoe UI&quot;; color: #374151; }
QCheckBox { font: 9pt &quot;Segoe UI&quot;; color: #374151; }
   </string>
