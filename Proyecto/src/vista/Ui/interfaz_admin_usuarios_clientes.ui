  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardTabla, QFrame#cardResumen, QFrame#cardNuevos, QFrame#cardAcciones, QFrame#cardSigue { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QPushButton#btnUsuarios { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio, QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnEstadisticas, QPushButton#btnConfiguracion, QPushButton#btnReportes, QPushButton#btnAyuda { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio:hover, QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover, QPushButton#btnConfiguracion:hover, QPushButton#btnReportes:hover, QPushButton#btnAyuda:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnNuevoUsuario, QPushButton#btnAccionNueva { background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 9pt &quot;Segoe UI&quot;; }
QPushButton[class=&quot;btnAccion&quot;] { background-color: white; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; font: 9pt &quot;Segoe UI&quot;; text-align: left; padding-left: 15px; }
QPushButton[class=&quot;btnIcon&quot;] { background-color: transparent; border: none; font: 11pt &quot;Segoe UI Emoji&quot;; }
QLineEdit { background-color: white; border: 1px solid #D9DEE7; border-radius: 8px; padding-left: 12px; font: 9pt &quot;Segoe UI&quot;; color: #374151; }
QComboBox { background-color: white; border: 1px solid #D9DEE7; border-radius: 8px; padding-left: 10px; font: 9pt &quot;Segoe UI&quot;; color: #6B7280; }
QTableWidget { background-color: white; border: none; gridline-color: #E6E6E6; font: 8pt &quot;Segoe UI&quot;; color: #374151; selection-background-color: #E6F7F5; }
QHeaderView::section { background-color: white; color: #1F2937; font: bold 8pt &quot;Segoe UI&quot;; border: none; border-bottom: 1px solid #E6E6E6; padding: 6px; }
   </string>
