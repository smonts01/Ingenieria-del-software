  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardEntrenos, QFrame#cardTiempo, QFrame#cardCalorias, QFrame#cardObjetivo, QFrame#cardGraficoCalorias, QFrame#cardDistribucion, QFrame#cardProgreso, QFrame#cardRacha, QFrame#cardSigue { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QFrame#barraProgresoBase1, QFrame#barraProgresoBase2, QFrame#barraProgresoBase3 { background-color: #E5E7EB; border-radius: 4px; }
QFrame#barraProgresoFill1 { background-color: #18B7A5; border-radius: 4px; }
QFrame#barraProgresoFill2 { background-color: #FF9F2E; border-radius: 4px; }
QFrame#barraProgresoFill3 { background-color: #8E6CFF; border-radius: 4px; }
QPushButton#btnEstadisticas { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio, QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnCalorias, QPushButton#btnPerfil, QPushButton#btnInformacion { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio:hover, QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnCalorias:hover, QPushButton#btnPerfil:hover, QPushButton#btnInformacion:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnMini, QPushButton#btnDetalleClase, QPushButton#btnEvolucion { background-color: #F3F4F6; color: #00A896; border: none; border-radius: 8px; font: bold 9pt &quot;Segoe UI&quot;; }</string>
  </property>
