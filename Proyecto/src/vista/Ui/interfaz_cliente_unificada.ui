<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>700</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>StayFit</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QStackedWidget#stackedWidget { background-color: #F7F9FA; border: none; }

/* Botones menú lateral — estado normal */
QPushButton#btnInicio,
QPushButton#btnClases,
QPushButton#btnEstadisticas,
QPushButton#btnPerfil,
QPushButton#btnInformacion {
    background-color: transparent;
    color: #333333;
    border: none;
    text-align: left;
    padding-left: 22px;
    font: 11pt &quot;Segoe UI&quot;;
    border-radius: 8px;
}
QPushButton#btnInicio:hover,
QPushButton#btnClases:hover,
QPushButton#btnEstadisticas:hover,
QPushButton#btnPerfil:hover,
QPushButton#btnInformacion:hover {
    background-color: #E6F7F5;
}

/* Botón activo — se aplica desde Python dinámicamente como propiedad */
QPushButton[activo=&quot;true&quot;] {
    background-color: #18B7A5;
    color: white;
    font: bold 11pt &quot;Segoe UI&quot;;
}

QPushButton#btnCerrarSesion {
    background-color: white;
    color: #18B7A5;
    border: 1px solid #18B7A5;
    border-radius: 8px;
    font: bold 10pt &quot;Segoe UI&quot;;
}

/* Tarjetas blancas generales */
QFrame#card1, QFrame#card2, QFrame#card3, QFrame#card4,
QFrame#cardTabla, QFrame#cardPago,
QFrame#cardClase1, QFrame#cardClase2, QFrame#cardClase3, QFrame#cardClase4,
QFrame#cardFiltros, QFrame#cardProxima,
QFrame#cardReserva1, QFrame#cardReserva2, QFrame#cardReserva3, QFrame#cardReserva4,
QFrame#infoReservas,
QFrame#cardEntrenos, QFrame#cardTiempo, QFrame#cardCalorias, QFrame#cardObjetivo,
QFrame#cardGraficoCalorias, QFrame#cardDistribucion, QFrame#cardRacha,
QFrame#cardPerfil, QFrame#cardInfoPersonal, QFrame#cardObjetivos,
QFrame#cardSobre, QFrame#cardHorario, QFrame#cardUbicacion,
QFrame#cardNormas, QFrame#cardContacto,
QFrame#cardSigue {
    background-color: white;
    border: 1px solid #E6E6E6;
    border-radius: 12px;
}
QFrame[class=&quot;classCard&quot;] { background-color: white; border: 1px solid #E6E6E6; border-radius: 12px; }
QFrame[class=&quot;badgeOk&quot;]   { background-color: #DDF7F2; border-radius: 8px; border: none; }
QFrame[class=&quot;infoBox&quot;]   { background-color: #EEF6FB; border-radius: 8px; border: none; }

QPushButton[class=&quot;btnReservar&quot;] { background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 9pt &quot;Segoe UI&quot;; }
QPushButton[class=&quot;btnSecundario&quot;] { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 9pt &quot;Segoe UI&quot;; }

QLineEdit, QComboBox {
    background-color: white;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding-left: 10px;
    color: #374151;
    font: 9pt &quot;Segoe UI&quot;;
}

QFrame#cardSigue { background-color: #18B7A5; border-radius: 14px; border: none; }

QTableWidget { background-color: white; border: 1px solid #E6E6E6; border-radius: 8px; gridline-color: #E6E6E6; font: 9pt &quot;Segoe UI&quot;; }
QHeaderView::section { background-color: white; color: #1F2937; font: bold 9pt &quot;Segoe UI&quot;; border: none; border-bottom: 1px solid #E6E6E6; padding: 6px; }

QFrame#barraProgresoFondo { background-color: #E5E7EB; border-radius: 4px; border: none; }
QFrame#barraProgresoValor { background-color: #18B7A5; border-radius: 4px; border: none; }
QFrame#barraProgresoBase1, QFrame#barraProgresoBase2, QFrame#barraProgresoBase3 { background-color: #E5E7EB; border-radius: 4px; }
QFrame#barraProgresoFill1 { background-color: #18B7A5; border-radius: 4px; }
QFrame#barraProgresoFill2 { background-color: #FF9F2E; border-radius: 4px; }
QFrame#barraProgresoFill3 { background-color: #8E6CFF; border-radius: 4px; }

QPushButton#btnMini, QPushButton#btnDetalleClase, QPushButton#btnEvolucion {
    background-color: #F3F4F6; color: #00A896; border: none; border-radius: 8px; font: bold 9pt &quot;Segoe UI&quot;;
}
QPushButton#btnGuardarCambios { background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnMapa { background-color: transparent; color: #00A896; border: none; font: bold 9pt &quot;Segoe UI&quot;; }
QPushButton#btnVerInscripciones { background-color: #18B7A5; color: white; border: none; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnPeriodo { background-color: white; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; font: 9pt &quot;Segoe UI&quot;; }

QLabel#lblCheck1, QLabel#lblCheck2, QLabel#lblCheck3, QLabel#lblCheck4,
QLabel#lblCheck5, QLabel#lblCheck6, QLabel#lblCheck7,
QLabel#lblNorma1, QLabel#lblNorma2, QLabel#lblNorma3,
QLabel#lblNorma4, QLabel#lblNorma5, QLabel#lblNorma6 {
    color: #18B7A5; font: bold 11pt &quot;Segoe UI&quot;;
}
   </string>
