   </rect>
  </property>
  <property name="windowTitle">
   <string>StayFit - Registrar nuevo usuario</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #F7F9FA; }
QLabel { background: transparent; color: #1F2937; font-family: &quot;Segoe UI&quot;; }
QPushButton { font-family: &quot;Segoe UI&quot;; }
QFrame#frameHeader { background-color: white; border-bottom: 1px solid #E5E7EB; }
QFrame#frameMenu { background-color: white; border-right: 1px solid #E5E7EB; }
QFrame#frameContenido { background-color: #F7F9FA; border: none; }
QFrame#cardDatosPersonales, QFrame#cardDatosAcceso, QFrame#cardTipoCliente, QFrame#cardRolUsuario, QFrame#cardSigue { background-color: #FFFFFF; border: 1px solid #DADDE2; border-radius: 12px; }
QPushButton#btnUsuarios { background-color: #18B7A5; color: white; border-radius: 8px; text-align: left; padding-left: 22px; font: bold 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio, QPushButton#btnClases, QPushButton#btnInscripciones, QPushButton#btnPagos, QPushButton#btnEstadisticas, QPushButton#btnConfiguracion { background-color: transparent; color: #333333; border: none; text-align: left; padding-left: 22px; font: 11pt &quot;Segoe UI&quot;; }
QPushButton#btnInicio:hover, QPushButton#btnClases:hover, QPushButton#btnInscripciones:hover, QPushButton#btnPagos:hover, QPushButton#btnEstadisticas:hover, QPushButton#btnConfiguracion:hover { background-color: #E6F7F5; border-radius: 8px; }
QPushButton#btnCerrarSesion { background-color: white; color: #18B7A5; border: 1px solid #18B7A5; border-radius: 8px; font: bold 10pt &quot;Segoe UI&quot;; }
QPushButton#btnRegistrarUsuario { background-color:#00BFA6; color: #FFFFFF; border: none; border-radius: 12px; font: bold 12pt &quot;Segoe UI&quot;; }
QPushButton#btnCancelar { background-color:white; color:#6B7280; border: 1px solid #DADDE2; border-radius: 12px; font: bold 11pt &quot;Segoe UI&quot;; }
QLineEdit { background-color: white; border: 1px solid #D9DEE7; border-radius: 8px; padding-left: 10px; font: 9pt &quot;Segoe UI&quot;; color: #374151; }
QComboBox { background-color: white; border: 1px solid #D9DEE7; border-radius: 8px; padding-left: 10px; font: 9pt &quot;Segoe UI&quot;; color: #374151; }
QRadioButton { background-color: transparent; color: #333333; font: bold 9pt &quot;Segoe UI&quot;; }
QRadioButton::indicator { width: 16px; height: 16px; }
   </string>
  </property>
